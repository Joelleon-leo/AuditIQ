      "isDeleted": false,
      "boundElements": [],
      "updated": 1787218550705,
      "link": null,
      "locked": false,
      "text": "• Ingests batch of evidence statements into `generate_embeddings()`\n• Utilizes OpenAI / OpenRouter embeddings client (1536 dims)\n• Generates dense semantic vector representation:\n  Vec(Evidence) = [ e_1, e_2, e_3, ... e_1536 ]",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Ingests batch of evidence statements into `generate_embeddings()`\n• Utilizes OpenAI / OpenRouter embeddings client (1536 dims)\n• Generates dense semantic vector representation:\n  Vec(Evidence) = [ e_1, e_2, e_3, ... e_1536 ]",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aW"
    },
