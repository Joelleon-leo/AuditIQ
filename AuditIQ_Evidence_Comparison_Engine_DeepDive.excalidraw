      "updated": 1787218550704,
      "link": null,
      "locked": false,
      "text": "• Resolves Asset Identity: 'hostname', 'url', 'id', 'name', 'asset_id'\n• Identifies Asset Type: server, database, endpoint, infra\n• Separates scalar telemetry metrics from metadata\n• Normalizes keys: 'disk_utilization' ➔ 'disk utilization'\n• Preserves values: '68%', '35 days', 'TLS 1.3', True/False",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Resolves Asset Identity: 'hostname', 'url', 'id', 'name', 'asset_id'\n• Identifies Asset Type: server, database, endpoint, infra\n• Separates scalar telemetry metrics from metadata\n• Normalizes keys: 'disk_utilization' ➔ 'disk utilization'\n• Preserves values: '68%', '35 days', 'TLS 1.3', True/False",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aH"
